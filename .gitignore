.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# model weights and audio never go in git
models/
*.safetensors
*.nemo
*.wav
!loadtest/probe/*.wav

# terraform state and secrets
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/example.tfvars
# .terraform.lock.hcl is NOT ignored: it is what actually pins the provider
# version, and it is meant to be committed so every apply resolves the same way.

# local kube/gcloud artefacts
kubeconfig*
*.json.key
