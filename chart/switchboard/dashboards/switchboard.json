{
  "uid": "switchboard",
  "title": "switchboard",
  "description": "Parakeet-TDT speech-to-text service: traffic, latency, where the time goes, saturation.",
  "tags": ["switchboard", "stt"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0 }
    ]
  },
  "panels": [
    { "type": "stat", "title": "Ready replicas", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Pods with the model loaded. switchboard_ready, summed.",
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [ { "refId": "A", "expr": "sum(switchboard_ready{job=\"__JOB__\"})" } ] },
    { "type": "stat", "title": "Requests / s", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum(switchboard:requests:rate1m)" } ] },
    { "type": "stat", "title": "p95 latency", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "End-to-end, from request in to response out, across all pods.",
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 4 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [ { "refId": "A", "expr": "switchboard:request_seconds:p95_1m" } ] },
    { "type": "stat", "title": "Real-time factor", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Seconds of model time per second of audio. Below 1 is faster than real time.",
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "switchboard:real_time_factor:1m" } ] },
    { "type": "stat", "title": "Queued for the model", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Requests waiting for the inference lock right now. What task 7 scales on.",
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(switchboard_queue_depth{job=\"__JOB__\"})" } ] },
    { "type": "stat", "title": "Alerts firing", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "noValue": "0", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [ { "refId": "A", "expr": "count(ALERTS{alertname=~\"Switchboard.*\",alertstate=\"firing\"})" } ] },

    { "type": "timeseries", "title": "Requests by outcome", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "switchboard:requests:rate1m", "legendFormat": "{{outcome}}" } ] },
    { "type": "timeseries", "title": "Latency percentiles (end to end)", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "From the histogram buckets summed over pods. A mean would hide exactly the requests people complain about.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "switchboard:request_seconds:p50_1m", "legendFormat": "p50" },
        { "refId": "B", "expr": "switchboard:request_seconds:p95_1m", "legendFormat": "p95" },
        { "refId": "C", "expr": "switchboard:request_seconds:p99_1m", "legendFormat": "p99" } ] },

    { "type": "timeseries", "title": "Where the time goes (p95)", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "If queue wait grows while inference stays flat, the model is fine and there are too few replicas.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(switchboard_inference_seconds_bucket{job=\"__JOB__\"}[1m])))", "legendFormat": "inference" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(switchboard_queue_wait_seconds_bucket{job=\"__JOB__\"}[1m])))", "legendFormat": "waiting for the model" },
        { "refId": "C", "expr": "switchboard:request_seconds:p95_1m", "legendFormat": "end to end" } ] },
    { "type": "timeseries", "title": "Saturation: queued and in flight", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (switchboard_queue_depth{job=\"__JOB__\"})", "legendFormat": "queued {{pod}}" },
        { "refId": "B", "expr": "sum by (pod) (switchboard_in_flight{job=\"__JOB__\"})", "legendFormat": "in flight {{pod}}" } ] },

    { "type": "timeseries", "title": "Pod CPU (cores)", "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "From the kubelet (cAdvisor), not from the service.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"__NAMESPACE__\",container=\"__CONTAINER__\"}[1m]))", "legendFormat": "{{pod}}" } ] },
    { "type": "timeseries", "title": "Pod memory vs its request", "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Working set is what the kernel counts towards the limit. The request line is what the scheduler reserved.",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"__NAMESPACE__\",container=\"__CONTAINER__\"})", "legendFormat": "{{pod}}" },
        { "refId": "B", "expr": "max(kube_pod_container_resource_requests{namespace=\"__NAMESPACE__\",container=\"__CONTAINER__\",resource=\"memory\"})", "legendFormat": "request" } ] }
  ]
}
